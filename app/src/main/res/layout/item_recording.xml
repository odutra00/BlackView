<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/tile_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Play / Video icon -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#2A3548"
            android:padding="8dp"
            android:src="@drawable/ic_fullscreen"
            android:tint="@color/primary_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvItemCameraBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#3300E5FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/primary_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="CÂMERA 1" />

                <TextView
                    android:id="@+id/tvItemDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="18/11/2026 19:45:00" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Duração: 15:20 • Tamanho: 45.2 MB" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#151922"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="[OK] Reproduzir"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
