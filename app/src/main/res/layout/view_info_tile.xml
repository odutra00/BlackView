<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tileInfoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tile_selector"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#151922"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvClockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_accent"
            android:textSize="36sp"
            android:textStyle="bold"
            tools:text="13:20:45" />

        <TextView
            android:id="@+id/tvClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            tools:text="Quarta-feira, 11 de Novembro" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginVertical="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tvOnlineCameras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/status_live"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="● 2/3 Câmeras Online" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNetworkInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            tools:text="Rede Local (192.168.0.0/24)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/btnOpenRecordings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#2500E5FF"
            android:gravity="center"
            android:padding="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_fullscreen"
                android:tint="@color/primary_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="[OK] Gravações  •  Segure [OK] Ajustes"
                android:textColor="@color/primary_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[OK] Tela Cheia • [PLAY] Áudio • [REC] DVR"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</FrameLayout>
