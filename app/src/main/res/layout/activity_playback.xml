<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootPlayback"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- VLC Video Layout for Hardware Accelerated Rendering -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/playbackVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Center Play/Pause Indicator (Flaches when toggled) -->
    <ImageView
        android:id="@+id/ivCenterStatus"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="#99000000"
        android:padding="16dp"
        android:src="@drawable/ic_fullscreen"
        android:tint="@color/text_primary"
        android:visibility="gone" />

    <!-- OSD OVERLAY -->
    <FrameLayout
        android:id="@+id/playbackOsd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- Top Header Info -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="#AA0D131F"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvPlaybackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Câmera 1 (Entrada)" />

            <TextView
                android:id="@+id/tvPlaybackSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_accent"
                android:textSize="13sp"
                tools:text="Gravado em: 18/11/2026 19:45:00" />
        </LinearLayout>

        <!-- Speed Badge (Top Right) -->
        <TextView
            android:id="@+id/tvSpeedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="#AA0D131F"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="1.0x"
            android:textColor="@color/primary_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Bottom Controls / Timeline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC0D131F"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Progress Bar / Timeline -->
            <SeekBar
                android:id="@+id/playbackSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/primary_accent"
                android:thumbTint="@color/focus_border" />

            <!-- Time stamps and hints -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimeCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="00:00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTimeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="15:00" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[◄ / ►] ±10s   •   [▲ / ▼] Velocidade   •   [OK] Pausar   •   [VOLTAR] Sair"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/playbackProgress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_accent"
        android:visibility="gone" />

</FrameLayout>
