<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- MOSAIC VIEW -->
    <LinearLayout
        android:id="@+id/layoutMosaic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/primary_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="• Monitor Local (TCL 65C755)"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHeaderClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="13:25:00" />
        </LinearLayout>

        <!-- 3x2 Grid for Cameras and Info Widget -->
        <GridLayout
            android:id="@+id/gridCameras"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <!-- Slot 1 (Row 0, Col 0): Camera 1 -->
            <FrameLayout
                android:id="@+id/slot0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1" />

            <!-- Slot 2 (Row 0, Col 1): Camera 2 -->
            <FrameLayout
                android:id="@+id/slot1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1" />

            <!-- Slot 3 (Row 0, Col 2): Camera 3 -->
            <FrameLayout
                android:id="@+id/slot2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1" />

            <!-- Slot 4 (Row 1, Col 0): Camera 4 -->
            <FrameLayout
                android:id="@+id/slot3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1" />

            <!-- Slot 5 (Row 1, Col 1): Camera 5 -->
            <FrameLayout
                android:id="@+id/slot4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1" />

            <!-- Slot 6 (Row 1, Col 2): Info / Clock Tile -->
            <FrameLayout
                android:id="@+id/slot5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1" />
        </GridLayout>
    </LinearLayout>

    <!-- FULLSCREEN VIEW CONTAINER (Overlays mosaic when opened) -->
    <FrameLayout
        android:id="@+id/layoutFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <org.videolan.libvlc.util.VLCVideoLayout
            android:id="@+id/fullscreenVideoLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Black scrim to prevent flash of previous camera frame -->
        <View
            android:id="@+id/fullscreenBlackScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:visibility="gone" />

        <!-- Fullscreen OSD Overlay (fade out after 3 seconds) -->
        <FrameLayout
            android:id="@+id/fullscreenOsd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:orientation="vertical"
                android:background="#99000000"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvFullscreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Câmera 1 - Entrada" />

                <TextView
                    android:id="@+id/tvFullscreenSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_accent"
                    android:textSize="14sp"
                    tools:text="192.168.0.141 • H.265 1080p • Áudio Ativo" />
            </LinearLayout>

            <!-- Badges container (Recording + Status) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFullscreenRecBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="#DDCC0000"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● GRAVANDO"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvFullscreenBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_live"
                    android:text="@string/status_live"
                    android:textColor="@color/status_live"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Exit & recording hint -->
            <TextView
                android:id="@+id/tvFullscreenHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="#AA000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="[VOLTAR] Mosaico   •   [PLAY/OK] Áudio   •   [VERMELHO / REC] Gravar DVR"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </FrameLayout>

        <!-- Fullscreen Loading Indicator -->
        <ProgressBar
            android:id="@+id/fullscreenProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/focus_border"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
